{
    "editor.minimap.enabled": false,
    "editor.scrollbar.verticalScrollbarSize": 10,
    "editor.scrollbar.horizontalScrollbarSize": 10,
    "editor.fontSize": 15,
    "editor.lineHeight": 1.45,
    "editor.hover.enabled": "off",
    "debug.inlineValues": "on",
    "editor.accessibilitySupport": "off",
    "workbench.startupEditor": "none",
    "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
        "other": "off"
    },
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "editor.fontFamily": "JetBrains Mono,Menlo, Monaco, 'Courier New', monospace",
    // "editor.fontFamily": "JetBrains Mono Medium,Menlo, Monaco, 'Courier New', monospace",
    // "editor.fontFamily": "JetBrains Mono ExtraLight,Menlo, Monaco, 'Courier New', monospace",
    // "editor.fontFamily": "JetBrains Mono Light,Menlo, Monaco, 'Courier New', monospace",
    "editor.guides.indentation": false,
    "editor.bracketPairColorization.enabled": false,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript][javascriptreact][typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json][jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[css][scss][less]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    // "workbench.editorAssociations": {
    // "*.md": "vscode.markdown.preview.editor"
    // },
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": true,
    "window.menuBarVisibility": "toggle",
    "diffEditor.hideUnchangedRegions.enabled": true,
    "window.title": "${dirty} ${activeEditorMedium}${separator}${folderName}",
    "git.autofetch": true,
    "keyboard.dispatch": "keyCode",
    "go.toolsManagement.autoUpdate": true,
    "git.decorations.enabled": false,
    "numberedBookmarks.gutterIconFillColor": "#3452b4",
    "numberedBookmarks.gutterIconNumberColor": "#f2f2f2",
    "workbench.editor.editorActionsLocation": "hidden",
    "chat.commandCenter.enabled": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "window.titleBarStyle": "custom",
    "git.openRepositoryInParentFolders": "never",
    "editor.parameterHints.enabled": false,
    "chat.disableAIFeatures": false,
    "redhat.telemetry.enabled": false,
    "window.confirmSaveUntitledWorkspace": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.browser.showInTitleBar": false,
    "editor.stickyScroll.enabled": false,
    "breadcrumbs.enabled": false,
    "explorer.confirmDelete": false,
    "chat.viewSessions.orientation": "stacked",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.activityBar.location": "hidden",
    "terminal.integrated.initialHint": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "git.confirmSync": false,
    "workbench.experimental.modernUI": true,
    "window.density.layout": "compact",
    "git.enableSmartCommit": true,
    "extensions.ignoreRecommendations": true,
    "workbench.reduceMotion": "on",
    "editor.scrollbar.vertical": "visible",
    "workbench.iconTheme": "vscode-modern-icons",
